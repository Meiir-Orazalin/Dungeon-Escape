{
  "name": "dungeon-escape",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "A deterministic dark fantasy dungeon combat and escape game built with Phaser and TypeScript.",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers playwright install chromium",
    "test:e2e": "pnpm build && PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:run && pnpm build"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "^8.2.1",
    "vitest": "4.1.10"
  }
}
